# Spotify Developer API Credentials
# 1. Go to https://developer.spotify.com/dashboard and open your app settings
# 2. Under 'Redirect URIs', add:
#    http://127.0.0.1:8888/callback
#    (Note: Spotify requires the numeric IP '127.0.0.1', not 'localhost')
# 3. Copy Client ID and Client Secret below and save as .env

RSPOTIFY_CLIENT_ID=your_client_id_here
RSPOTIFY_CLIENT_SECRET=your_client_secret_here
RSPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
