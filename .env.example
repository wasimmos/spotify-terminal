# Spotify Developer API Credentials
# 1. Create a free Spotify App at https://developer.spotify.com/dashboard
# 2. Add 'http://localhost:8888/callback' under Redirect URIs in your Spotify App Settings
# 3. Copy Client ID and Client Secret below and rename this file to .env

RSPOTIFY_CLIENT_ID=your_client_id_here
RSPOTIFY_CLIENT_SECRET=your_client_secret_here
RSPOTIFY_REDIRECT_URI=http://localhost:8888/callback
